# Railway Environment Variables Configuration
# Copy and configure these in your Railway project settings

# ========== REQUIRED ==========
# Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ========== OPTIONAL: Ollama Chatbot Integration ==========
# Set to 'true' to enable Ollama-based chatbot
# Requires a separate Railway service running Dockerfile.ollama (see RAILWAY_DEPLOY.md).
# OLLAMA_BASE_URL must point to that service's internal Railway URL, e.g.:
#   http://ollama.railway.internal:11434
CHATBOT_USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.12

# ========== OPTIONAL: Web Search in Chatbot ==========
CHATBOT_ENABLE_WEB_SEARCH=true
CHATBOT_WEB_SEARCH_TIMEOUT_SECONDS=10
CHATBOT_WEB_SEARCH_MAX_SNIPPETS=2

# ========== API Configuration (Auto-set by Railway) ==========
# PORT is automatically set by Railway
# API_HOST should be 0.0.0.0 for Railway
# These are optional to override:
# PORT=8000
# API_HOST=0.0.0.0
