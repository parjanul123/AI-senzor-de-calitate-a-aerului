# Standalone Ollama service for Railway, so the chatbot can use the real LLM in production
# (not just the local dev machine). Deploy this as its own Railway service, pointing
# "Dockerfile Path" to this file, then set OLLAMA_BASE_URL on the backend service to its
# internal Railway URL (e.g. http://ollama.railway.internal:11434).
FROM ollama/ollama:latest

# Pick a model that fits your Railway plan's RAM. The Hobby plan allows up to 8GB RAM
# per service, which fits a quantized 7B model (~5GB) like the one used locally.
# Inference is CPU-only on Hobby (no GPU), so replies will be noticeably slower than
# on your local machine. Switch to a smaller model (e.g. qwen2.5:3b-instruct) if
# responses feel too slow or you hit RAM limits.
ENV OLLAMA_MODEL=qwen2.5:7b-instruct
ENV OLLAMA_HOST=0.0.0.0:11434

COPY ollama-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 11434

ENTRYPOINT ["/entrypoint.sh"]
